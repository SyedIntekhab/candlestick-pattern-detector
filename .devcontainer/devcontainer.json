{
  "name": "EdCircles static site",
  "image": "mcr.microsoft.com/devcontainers/base:bullseye",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "index.html"
      ]
    }
  },
  "postAttachCommand": {
    "server": "python3 -m http.server 8080"
  },
  "portsAttributes": {
    "8080": {
      "label": "EdCircles",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8080
  ]
}
